{
  "manifest_version": 3,
  "name": "爪爪 · Paw Work",
  "version": "1.0.0",
  "description": "爪爪 · Paw Work — 伸爪选中网页元素，安静完成下载与导出。Pick something, do anything.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "downloads",
    "offscreen",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "toggle-picker": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "开启/关闭 伸爪（页面点选）"
    },
    "capture-screenshot": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "区域截图 → 剪贴板 + 对话附件"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "sandbox": {
    "pages": [
      "src/sandbox/runtime.html"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content_script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/agent/vnext/sessionWorkspace/pickContext.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "打开 爪爪 · Paw Work"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "minimum_chrome_version": "115"
}
