# The repo root is the unpacked load root (manifest.json is here).
# Do not ignore src/ or src/preview/vendor/.

# Dependencies (not required to load the unpacked extension)
node_modules/

# Chrome packaging / signing — never commit
*.pem
*.crx
*.p12
*.pfx

# Secrets / local keys
.env
.env.*
!.env.example
*.key
credentials.json
secrets/
**/tldraw.license
**/*license*key*

# OS junk
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Editor
.idea/
.vscode/
*.swp
*~

# Logs / caches
*.log
.cache/
**/__pycache__/
*.pyc
output/playwright/*-profile/
.playwright-cli/

# Local Playwright / smoke evidence (not product)
output/

# Pack output — scripts/pack_extension.py regenerates it at release time
extension/
artifacts/
dist/
*.zip
!src/**/*.zip
