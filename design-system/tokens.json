{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Paw Work / 爪爪",
  "version": "1.0.0",
  "description": "Product design tokens extracted from the MV3 sidepanel UI (src/sidepanel/css/tokens.css + live chrome). Source of truth for agents and CSS.",
  "meta": {
    "product": "Paw Work",
    "brand": "爪爪",
    "surfaces": ["sidepanel", "selection overlay", "dialogs"],
    "themes": ["dark", "light"],
    "extractedFrom": [
      "src/sidepanel/css/tokens.css",
      "src/sidepanel.css",
      "src/sidepanel.html"
    ],
    "method": "Adapted from extract-design-system (arvindrk): reverse-engineer live product primitives into starter token files — not a third-party website scrape."
  },
  "color": {
    "dark": {
      "bg": {
        "void": { "$value": "#000000", "$type": "color" },
        "stage": { "$value": "#050506", "$type": "color" },
        "panel": { "$value": "#050506", "$type": "color" },
        "soft": { "$value": "#0c0c0f", "$type": "color" },
        "elevated": { "$value": "#121214", "$type": "color" },
        "elevated2": { "$value": "#1a1a1f", "$type": "color" }
      },
      "text": {
        "primary": { "$value": "#f5f2f4", "$type": "color" },
        "muted": { "$value": "#a39aa3", "$type": "color" },
        "faint": { "$value": "#6b636b", "$type": "color" }
      },
      "border": {
        "default": { "$value": "rgba(255,255,255,0.08)", "$type": "color" },
        "strong": { "$value": "rgba(255,255,255,0.14)", "$type": "color" }
      },
      "accent": {
        "primary": { "$value": "#f43f8c", "$type": "color", "$description": "Rose primary (dark)" },
        "hover": { "$value": "#e11d74", "$type": "color" },
        "secondary": { "$value": "#e879f9", "$type": "color" },
        "soft": { "$value": "rgba(244,63,140,0.14)", "$type": "color" },
        "ring": { "$value": "rgba(244,63,140,0.28)", "$type": "color" }
      },
      "semantic": {
        "success": { "$value": "#34d399", "$type": "color" },
        "warning": { "$value": "#fbbf24", "$type": "color" },
        "danger": { "$value": "#fb7185", "$type": "color" }
      }
    },
    "light": {
      "bg": {
        "void": { "$value": "#f7f4ef", "$type": "color" },
        "stage": { "$value": "#f7f4ef", "$type": "color" },
        "panel": { "$value": "#fbf8f3", "$type": "color" },
        "soft": { "$value": "#f3eee6", "$type": "color" },
        "elevated": { "$value": "#ffffff", "$type": "color" },
        "elevated2": { "$value": "#fffcf8", "$type": "color" }
      },
      "text": {
        "primary": { "$value": "#1c1915", "$type": "color" },
        "muted": { "$value": "#6b635a", "$type": "color" },
        "faint": { "$value": "#9a9186", "$type": "color" }
      },
      "border": {
        "default": { "$value": "rgba(40,32,24,0.08)", "$type": "color" },
        "strong": { "$value": "rgba(40,32,24,0.14)", "$type": "color" }
      },
      "accent": {
        "primary": { "$value": "#d97706", "$type": "color", "$description": "Amber primary (light)" },
        "hover": { "$value": "#b45309", "$type": "color" },
        "secondary": { "$value": "#f59e0b", "$type": "color" },
        "soft": { "$value": "rgba(217,119,6,0.12)", "$type": "color" },
        "ring": { "$value": "rgba(217,119,6,0.28)", "$type": "color" }
      },
      "semantic": {
        "success": { "$value": "#059669", "$type": "color" },
        "warning": { "$value": "#b45309", "$type": "color" },
        "danger": { "$value": "#e11d48", "$type": "color" }
      }
    }
  },
  "radius": {
    "xs": { "$value": "6px", "$type": "dimension" },
    "sm": { "$value": "10px", "$type": "dimension", "$description": "Primary control radius (pick/shot/group/select)" },
    "md": { "$value": "14px", "$type": "dimension" },
    "pill": { "$value": "999px", "$type": "dimension", "$description": "Use sparingly — prefer sm for product chrome" }
  },
  "space": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" }
  },
  "typography": {
    "fontFamily": {
      "ui": {
        "$value": "system-ui, -apple-system, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif",
        "$type": "fontFamily"
      },
      "code": {
        "$value": "ui-monospace, 'Cascadia Code', 'SF Mono', Consolas, monospace",
        "$type": "fontFamily"
      }
    },
    "size": {
      "xs": { "$value": "10px", "$type": "dimension" },
      "sm": { "$value": "11px", "$type": "dimension" },
      "md": { "$value": "12.5px", "$type": "dimension" },
      "control": { "$value": "13px", "$type": "dimension" },
      "body": { "$value": "14px", "$type": "dimension" }
    },
    "weight": {
      "medium": { "$value": "500", "$type": "fontWeight" },
      "semibold": { "$value": "600", "$type": "fontWeight" },
      "bold": { "$value": "700", "$type": "fontWeight" }
    }
  },
  "control": {
    "height": {
      "primary": { "$value": "34px", "$type": "dimension", "$description": "pick / shot / group select" },
      "compact": { "$value": "26px", "$type": "dimension" },
      "meta": { "$value": "18px", "$type": "dimension", "$description": "model select & meta chrome" }
    },
    "minWidth": {
      "primary": { "$value": "76px", "$type": "dimension" }
    },
    "padX": {
      "primary": { "$value": "12px", "$type": "dimension" }
    }
  },
  "shadow": {
    "sm": { "$value": "0 2px 4px rgba(0,0,0,0.25)", "$type": "shadow" },
    "md": { "$value": "0 6px 16px rgba(0,0,0,0.4)", "$type": "shadow" },
    "card": { "$value": "0 1px 2px rgba(0,0,0,0.4), 0 4px 16px rgba(0,0,0,0.28)", "$type": "shadow" },
    "panel": { "$value": "0 24px 56px rgba(0,0,0,0.55)", "$type": "shadow" }
  },
  "motion": {
    "ease": {
      "out": { "$value": "cubic-bezier(0.22, 1, 0.36, 1)", "$type": "cubicBezier" },
      "inOut": { "$value": "cubic-bezier(0.45, 0, 0.2, 1)", "$type": "cubicBezier" }
    },
    "duration": {
      "1": { "$value": "100ms", "$type": "duration" },
      "2": { "$value": "150ms", "$type": "duration" },
      "3": { "$value": "220ms", "$type": "duration" },
      "4": { "$value": "280ms", "$type": "duration" }
    }
  },
  "components": {
    "primaryAction": {
      "examples": ["pick-btn"],
      "fill": "accent.primary",
      "radius": "radius.sm",
      "height": "control.height.primary",
      "weight": "typography.weight.bold"
    },
    "secondaryAction": {
      "examples": ["shot-btn", "group-select-trigger"],
      "fill": "bg.elevated",
      "border": "border.strong",
      "radius": "radius.sm",
      "height": "control.height.primary",
      "hover": "accent.soft + accent.ring focus ring"
    },
    "menu": {
      "examples": ["group-select-menu", "session-bind-add-menu"],
      "radius": "radius.sm",
      "surface": "bg.elevated",
      "border": "border.strong",
      "shadow": "shadow.card"
    },
    "chip": {
      "examples": ["bound-group-chip"],
      "height": "control.height.compact",
      "radius": "radius.sm",
      "surface": "accent.soft mixed with elevated"
    },
    "metaControl": {
      "examples": ["model-select-mini"],
      "height": "control.height.meta",
      "size": "typography.size.xs",
      "color": "text.faint",
      "note": "Keep quiet — never compete with primary actions"
    }
  }
}
